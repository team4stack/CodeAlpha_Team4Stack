# Team4Stack Collaborators Root .gitignore

# Ignore old project folder (if exists)
/Team4Stack/

# Node modules (in any subdirectory)
**/node_modules/
node_modules/

# Build outputs
**/.next/
**/out/
**/dist/
**/build/
.next/
out/
dist/
build/

# Environment files
.env
.env.local
.env*.local
**/.env
**/.env.local
**/.env*.local

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
**/*.log

# Lock files (optional - you might want to commit these)
# package-lock.json
# yarn.lock

# Temporary files
*.tmp
*.temp
.cache/
**/.cache/

# TypeScript
*.tsbuildinfo
**/*.tsbuildinfo
