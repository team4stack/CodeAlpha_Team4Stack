# Server
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Supabase (required)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# Admin API tokens (HMAC). Min 16 chars; required in production.
ADMIN_API_TOKEN_SECRET=change-me-min-16-characters

# Visitor tracking hash salt (recommended in production so IPs are stored only as HMAC hashes)
VISITOR_HASH_SECRET=change-me-visitor-hash-secret

# Super-admin login allowlist (server-only; optional).
# If SUPERADMIN_PRIMARY_EMAIL is set, only that email may log in as super_admin.
# Else if ALLOWED_ADMIN_EMAILS is set (comma-separated), those emails may log in as super_admin.
# If neither is set, any valid super_admin row + password may receive an apiToken.
# SUPERADMIN_PRIMARY_EMAIL=
# ALLOWED_ADMIN_EMAILS=

# YouTube Data API — server proxy only (never NEXT_PUBLIC_)
# If 403: enable "YouTube Data API v3" and fix key restrictions. The proxy sends Referer from
# FRONTEND_URL / CORS_ORIGIN so "HTTP referrers" keys can allow e.g. http://localhost:3000/*
# Override referer only if needed:
# YOUTUBE_API_REFERER=http://localhost:3000/
YOUTUBE_API_KEY=

# Cloudinary (server-only)
# Either set CLOUDINARY_URL OR set CLOUDINARY_CLOUD_NAME + CLOUDINARY_API_KEY + CLOUDINARY_API_SECRET
# CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# Course files storage provider (cloudinary | google_drive)
# Default is cloudinary.
# COURSE_FILES_STORAGE_PROVIDER=cloudinary
#
# Google Drive direct upload (recommended for assignments files when provider is google_drive)
# Set either GOOGLE_DRIVE_SERVICE_ACCOUNT_FILE (absolute path to JSON key)
# or GOOGLE_DRIVE_SERVICE_ACCOUNT_JSON (full json content as one-line string).
# GOOGLE_DRIVE_SERVICE_ACCOUNT_FILE=
# GOOGLE_DRIVE_SERVICE_ACCOUNT_JSON=
# GOOGLE_DRIVE_ASSIGNMENTS_ROOT_FOLDER_ID=
# GOOGLE_DRIVE_ASSIGNMENT_ADMIN_FOLDER_ID=
# GOOGLE_DRIVE_ASSIGNMENT_STUDENT_FOLDER_ID=
# GOOGLE_DRIVE_ASSIGNMENT_TEMPLATES_FOLDER_ID=
# GOOGLE_DRIVE_ASSIGNMENT_SUBMISSIONS_FOLDER_ID=
#
# Google Drive upload gateway (optional, used when COURSE_FILES_STORAGE_PROVIDER=google_drive)
# This should point to your own secure backend/webhook that receives fileDataUrl + fileName + folder
# and uploads to Google Drive with service-account OAuth.
# GOOGLE_DRIVE_UPLOAD_WEBHOOK_URL=
# GOOGLE_DRIVE_UPLOAD_WEBHOOK_TOKEN=
