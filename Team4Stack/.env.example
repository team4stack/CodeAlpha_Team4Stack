# Team4Stack Environment Variables Template
# Copy this file to .env and fill in the actual values

# reCAPTCHA
VITE_RECAPTCHA_SITE_KEY=your_recaptcha_site_key_here

# Contact Information
VITE_CONTACT_EMAIL=your_contact_email_here
VITE_PRIMARY_PHONE=your_primary_phone_number_here
VITE_TEAM_MEMBER_1_PHONE=team_member_1_phone_here
VITE_TEAM_MEMBER_2_PHONE=team_member_2_phone_here
VITE_TEAM_MEMBER_3_PHONE=team_member_3_phone_here
VITE_TEAM_MEMBER_4_PHONE=team_member_4_phone_here

# External Links
VITE_FIVERR_PROFILE_URL=your_fiverr_profile_url_here

# YouTube API
VITE_YOUTUBE_API_KEY=your_youtube_api_key_here

# Supabase
VITE_SUPABASE_URL=your_supabase_url_here
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here